# NexaOS Kernel Configuration (6.18.33)
# Optimized for Wayland/Sway desktop on x86_64 QEMU/KVM

# ============================================================================
# CORE ARCHITECTURE
# ============================================================================
CONFIG_X86=y
CONFIG_X86_64=y
CONFIG_X86_GENERIC=y
CONFIG_GENERIC_CPU=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8

# ============================================================================
# GENERAL SETUP
# ============================================================================
CONFIG_POSIX_TIMERS=y
CONFIG_HAVE_EFFICIENT_UNALIGNED_ACCESS=y
CONFIG_GENERIC_CLOCKEVENTS_MIN_ADJUST=y

# ============================================================================
# SECURITY & HARDENING
# ============================================================================
CONFIG_HAVE_ARCH_SECCOMP_FILTER=y
CONFIG_SECCOMP_FILTER=y
CONFIG_HAVE_EFFICIENT_UNALIGNED_ACCESS=y
CONFIG_HAVE_ARCH_HARDENED_USERCOPY=y
CONFIG_HAVE_HW_BREAKPOINT=y
CONFIG_HAVE_ARCH_MMAP_RND_BITS=y
CONFIG_ARCH_MMAP_RND_BITS=32
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_HAVE_STACK_VALIDATION=y

# ============================================================================
# MEMORY & PAGING
# ============================================================================
CONFIG_FLATMEM=y
CONFIG_FLAT_NODE_MAP=y
CONFIG_PAGEFLAGS_EXTENDED=y
CONFIG_PAGE_EXTENSION=y
CONFIG_HAVE_MEMBLOCK_NODE_MAP=y
CONFIG_GENERIC_MEMBLOCK_NOTIFY_DEFERRED=y

# ============================================================================
# FILESYSTEMS - CRITICAL FOR ROOT MOUNT
# ============================================================================
CONFIG_BLK_DEV_INITRD=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_XATTR=y
CONFIG_EXT4_POSIX_ACL=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# ============================================================================
# GRAPHICS & DRM - CRITICAL FOR WAYLAND
# ============================================================================
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_LOAD_EDID_FIRMWARE=y
CONFIG_DRM_MIPI_DSI=y

# Framebuffer support
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_MONO=y
CONFIG_LOGO_LINUX_VGA16=y

# Virtio GPU (QEMU)
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y

# Virtio Display
CONFIG_DRM_VIRTIO_GPU_BLOB=y

# VGA Support (fallback)
CONFIG_VGA_ARB=y
CONFIG_VGA_ARB_MAX_GPUS=16

# ============================================================================
# GPU DRIVERS & RENDERING
# ============================================================================
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_KMS_FB_HELPER=y

# Basic rendering
CONFIG_DRM_GEM_SHMEM_HELPER=y
CONFIG_DRM_GEM_CMA_HELPER=y

# Atomic display control (required for Wayland)
CONFIG_DRM_GEM_VRAM_HELPER=y
CONFIG_DRM_GEM_VRAM_HELPER_MANAGED=y

# I2C for monitor detection
CONFIG_I2C=y
CONFIG_I2C_ALGOBIT=y
CONFIG_I2C_BOARDINFO=y
CONFIG_I2C_HID=y

# EDID detection
CONFIG_FB_DDC=y

# ============================================================================
# VIRTIO & QEMU DEVICES
# ============================================================================
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_RNG=y
CONFIG_VIRTIO_INPUT=y

# ============================================================================
# INPUT DEVICES - CRITICAL FOR MOUSE/KEYBOARD
# ============================================================================
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_INPUT_TABLET=y
CONFIG_INPUT_TOUCHPAD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y

# Virtio input
CONFIG_INPUT_VIRTIO=y

# ACPI for power events
CONFIG_ACPI_BUTTON=y

# ============================================================================
# BLOCK DEVICES
# ============================================================================
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=1
CONFIG_SCSI=y
CONFIG_SCSI_TGT=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_VIRTIO=y

# ============================================================================
# NETWORKING
# ============================================================================
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV4=y
CONFIG_IP_DYNAMIC_SYSCTL=y
CONFIG_IPV4_LOOPBACK_ONLY=n
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_ROUTE_VERBOSE=y

# DHCP support
CONFIG_DHCP=y

# IPv6 (nice to have)
CONFIG_IPV6=y

# Network testing
CONFIG_ICMP=y
CONFIG_ICMP_ECHO=y

# ============================================================================
# USB - OPTIONAL (for physical hardware)
# ============================================================================
CONFIG_USB=m
CONFIG_USB_EHCI_HCD=m
CONFIG_USB_XHCI_HCD=m
CONFIG_USB_HID=m
CONFIG_HID_SUPPORT=y

# ============================================================================
# SOUND - OPTIONAL (Wayland compatible)
# ============================================================================
CONFIG_SND=m
CONFIG_SND_TIMER=m
CONFIG_SND_PCM=m
CONFIG_SND_HDA=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_HWDEP=y

# ============================================================================
# TTY & CONSOLE
# ============================================================================
CONFIG_TTY=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# QEMU serial ports
CONFIG_SERIAL_8250_PCI=y

# ============================================================================
# POWER MANAGEMENT
# ============================================================================
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_PM_SLEEP_SMP=y
CONFIG_SUSPEND=y
CONFIG_SUSPEND_DEFAULT_DEF=1
CONFIG_HIBERNATION=y

# ============================================================================
# DEBUG OPTIONS (OPTIONAL - for troubleshooting)
# ============================================================================
# CONFIG_DEBUG_KERNEL=n
# CONFIG_DEBUG_INFO=n (disable to reduce kernel size)
# CONFIG_FRAME_POINTER=n

# ============================================================================
# MODULES (OPTIONAL - keep compiled-in for simplicity)
# ============================================================================
# This kernel is configured with most features built-in (=y) rather than
# as modules (=m) for simpler embedded/container deployment.
# Adjust as needed for your use case.

# ============================================================================
# IMPORTANT: MISSING FEATURES (known gaps)
# ============================================================================
# - Bluetooth: Not required for desktop
# - Wireless: Not used in QEMU (use virtio-net)
# - 3D acceleration: GPU drivers in userspace (Mesa)
# - Audio: Included but needs userspace daemon (PulseAudio/PipeWire)

# ============================================================================
# NOTES
# ============================================================================
# This config is optimized for:
# 1. QEMU/KVM with virtio devices
# 2. Wayland/Sway desktop environment
# 3. Alpine Linux minimal userspace
# 4. Desktop use cases (not server/embedded)
#
# Generate from this file:
#   kernel/linux-6.18.33/.config <- Copy this file
#   cd kernel/linux-6.18.33
#   make olddefconfig    # Accept defaults for new options
#   make -j$(nproc)
#
# Verify critical options:
#   grep CONFIG_DRM kernel/linux-6.18.33/.config
#   grep CONFIG_VIRTIO kernel/linux-6.18.33/.config
#   grep CONFIG_EXT4 kernel/linux-6.18.33/.config
