    button "Copy"
  column
    row
      field "Window title" = "My window"
      field "App id, like my-app" = "my-app"
    row
      column
        note "Parts"
        list "" (10 rows)
          * "Heading"
          - "Text"
          - "Note"
          - "Button"
          - "Main button"
          - "Text field"
          - "Check box"
          - "List"
          - "Row"
          - "Column"
      column
        note "Your window"
        list "Nothing in the window yet. Pick a part on the left and press Add (Ctrl+Return)." (3 rows)
          - "Row"
          - "      Button: Inside"
          * "      Heading: After"
    note "The words it shows:"
    row
      field "Its words" = "After"
      check off "Starts checked" (off)
    row
      button "Add"
      button "Up"
      button "Down"
      button "Into"
      button "Out"
    row
      danger button "Remove"
      button "New design"
