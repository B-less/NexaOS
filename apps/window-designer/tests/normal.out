--- Documents/notes-app.nx
// Notes: made with Window Designer.
// Fill in what each part does where it says "your code here".
use ui

fn main() -> !void {
    let page = ui.start("notes-app", "Notes")?
    ui.heading(page, "My notes")
    let write_a_note_field = ui.entry(page, "Write a note")
    let row1 = ui.row(page)
    let add_note_button = ui.primary_button(row1, "Add note")
    let clear_button = ui.button(row1, "Clear")
    let no_notes_yet_list = ui.list(page, "No notes yet. Write one above and press Add note.")
    let keep_them_sorted_check = ui.check(page, "Keep them \"sorted\" \{by date\}", true)
    while true {
        match ui.wait() {
            Clicked(id) => {
                if id == add_note_button {
                    // your code here
                    ui.status("You pressed “Add note”.")
                } else if id == clear_button {
                    // your code here
                    ui.status("You pressed “Clear”.")
                }
            }
            Submitted(id, text) => {
                if id == write_a_note_field {
                    // your code here: Enter was pressed in the text field
                    ui.status("You wrote: {text}")
                }
            }
            Toggled(id, on) => {
                if id == keep_them_sorted_check {
                    // your code here
                    ui.status("“Keep them \"sorted\" \{by date\}” is now {on}.")
                }
            }
            Selected(id, index) => {
                if id == no_notes_yet_list {
                    // your code here: fill the list with ui.set_items
                    ui.status("Row {index} was picked.")
                }
            }
            Closed => { return ok() }
            _ => { }
        }
    }
    return ok()
}
