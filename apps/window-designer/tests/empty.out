--- Documents/my-app.nx
// My window: made with Window Designer.
// Fill in what each part does where it says "your code here".
use ui

fn main() -> !void {
    let page = ui.start("my-app", "My window")?
    while true {
        match ui.wait() {
            Closed => { return ok() }
            _ => { }
        }
    }
    return ok()
}
