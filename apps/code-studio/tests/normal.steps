# program: ../apps/code-studio/src/main.nx
# tree: full
# Code Studio, used the normal way: a new program with a mistake, the
# mistake picked and explained, fixed, laid out, saved and run.
file Documents/readme.txt my documents
window Code Studio
shot empty
key ctrl+shift+F12
key ctrl+n
wait 2
shot new
key ctrl+shift+F12
# a program with a mistake: `total` can't change
key ctrl+a
type fn main() {
key Return
type let total = 1
key Return
type total += 41
key Return
type print("The answer is {total}")
key Return
type }
wait 3
shot mistake
key ctrl+shift+F12
# into the list of mistakes: its hint, then what it means
key ctrl+Tab Down
wait 0.5
key F1
wait 2
shot explained
key ctrl+shift+F12
# Enter goes to the mistake; fix it on the line above
key Return
key Up Home shift+ctrl+Right
type var
wait 3
key ctrl+shift+F12
# lay it out, save it, run it
key ctrl+shift+f
wait 2
key ctrl+s
window Save the program
wait 1
key ctrl+a
type answer.nx
key Return
gone Save the program
window Code Studio
wait 1
key F5
wait 6
shot ran
key ctrl+shift+F12
key Escape
show Documents/answer.nx
