column
  row
    button "Open…"
    button "Save"
    button "New"
  row
    button "Lay out"
    button "Explain"
    button "Stop" (off)
    primary button "Run"
  column
    note "/HOME/Documents/empty.nx"
    editor (1 lines, 0 marked, at 1:1, colours nexalang-horizon)
    list "No mistakes found." (1 rows)
      - "Line 1: the program has no `fn main()`"
status "1 mistake. Pick one to see it; Enter goes there."
column
  row
    button "Open…"
    button "Save"
    button "New"
  row
    button "Lay out"
    button "Explain"
    button "Stop" (off)
    primary button "Run"
  column
    note "/HOME/Documents/windows.nx"
    editor (4 lines, 0 marked, at 1:1, colours nexalang-horizon)
      | "fn main() {"
      | "    print(\"crlf\")"
      | "}"
    list "No mistakes found." (0 rows)
    code (6 lines)
      | "Running windows.nx…"
      | ""
      | "crlf"
      | ""
      | "[The program ended.]"
status "The program ended."
column
  row
    button "Open…"
    button "Save"
    button "New"
  row
    button "Lay out"
    button "Explain"
    button "Stop" (off)
    primary button "Run"
  column
    note "/HOME/Documents/my \"odd\" file.nx"
    editor (4 lines, 0 marked, at 1:1, colours nexalang-horizon)
      | "fn main() {"
      | "    print(\"odd\")"
      | "}"
    list "No mistakes found." (0 rows)
    code (6 lines)
      | "Running my \"odd\" file.nx…"
      | ""
      | "odd"
      | ""
      | "[The program ended.]"
status "The program ended."
