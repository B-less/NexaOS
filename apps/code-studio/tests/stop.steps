# program: ../apps/code-studio/src/main.nx
# tree: full
# Running: a program that never stops is stopped; a program with a
# mistake can't be laid out, and Run shows nexac's message.
file Documents/loop.nx use time\n\nfn main() {\n    print("started")\n    while true {\n        time.sleep_ms(100)\n    }\n}\n
file Documents/broken.nx fn main() {\n    print(1 +)\n}\n
window Code Studio
key ctrl+o
window Open a NexaLang file
key ctrl+l
wait 1
type loop.nx
wait 1
key Return
gone Open a NexaLang file
window Code Studio
wait 2
# nothing to explain
key F1
key ctrl+shift+F12
key ctrl+Return
wait 5
shot running
key ctrl+shift+F12
# F5 does nothing while it runs; Shift+F5 stops it
key F5
key shift+F5
wait 3
shot stopped
key ctrl+shift+F12
key ctrl+o
window Open a NexaLang file
key ctrl+l
wait 1
type broken.nx
wait 1
key Return
gone Open a NexaLang file
window Code Studio
wait 2
key ctrl+shift+f
wait 2
shot cant-lay-out
key ctrl+shift+F12
key F5
wait 4
shot run-mistake
key ctrl+shift+F12
key Escape
