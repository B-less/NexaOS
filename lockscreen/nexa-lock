#!/bin/sh
# Lock the screen: nexa-locker (C, tools-c/nexa-locker) draws the NexaOS
# lock screen; swaylock is the fallback if it can't lock (no
# ext-session-lock in the compositor, or the program is missing).
#
# Options are passed on: --boot (the session has just started: "Welcome"),
# --switch-to NAME (lock, play the hand-over, then put NAME's desktop on
# screen through nexa-sessiond).
# Returns once the screen is locked, so the lid handler can suspend right
# after and swayidle keeps running.
set -u

# One lock screen at a time: the idle timer, the lid, the power menu and
# the login lock can all fire together. The lock file stays held by the
# lock screen (it inherits fd 9) for as long as it runs.
run=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
exec 9>"$run/nexa-lock.lock"
flock -n 9 || exit 0
# This person's lock screen only: with two people signed in, the other
# person's (paused) lock screen must not stop this one locking.
pgrep -u "$(id -u)" -x nexa-locker >/dev/null 2>&1 && exit 0
pgrep -u "$(id -u)" -x swaylock >/dev/null 2>&1 && exit 0

if command -v nexa-locker >/dev/null 2>&1; then
    nexa-locker --daemonize "$@"
    rc=$?
    [ $rc = 0 ] && exit 0
    # 3: --switch-to someone who can't be switched to; it said why, and
    # nothing was locked (the desktop stays as it was).
    [ $rc = 3 ] && exit 3
    logger -t nexa-lock "nexa-locker couldn't lock (exit $rc); using swaylock" 2>/dev/null || true
    # swaylock can't hand over to someone else: just lock.
    case " $* " in *" --switch-to "*) set -- ;; esac
fi

# swaylock: the theme's colours (~/.config/swaylock/config, from
# nexa-theme) over the blurred wallpaper. Never a screenshot: right after
# login or logout the desktop isn't drawn yet, and the lock was black.
if [ -f /etc/nexa/login-required ]; then
    prompt="Type your password to unlock"
    extra="--ignore-empty-password"
else
    prompt="Press Enter to unlock"
    extra=""
fi
common="--daemonize --clock --timestr %H:%M --indicator --indicator-idle-visible --indicator-radius 120 --indicator-thickness 8 --font Inter --show-failed-attempts"
wall=/usr/share/backgrounds/nexaos/wallpaper.png
# shellcheck disable=SC2086
[ -f "$wall" ] && swaylock $common --datestr "$prompt" $extra --image "$wall" --scaling fill --effect-blur 9x4 --effect-vignette 0.4:0.6 && exit 0
logger -t nexa-lock "swaylock with effects failed; locking with a plain background" 2>/dev/null || true
# shellcheck disable=SC2086
exec swaylock $common --datestr "$prompt" $extra --color 0c1228
