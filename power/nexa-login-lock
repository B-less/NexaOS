#!/bin/sh
# Every new desktop session opens on the lock screen: after each boot and
# after "Log out" (compositor.logout leaves a marker; it's used up here).
# Installed systems ask for the password; the live USB's account has none,
# so there Enter starts the session. Opt out per user from Settings >
# Power ("Ask for my password when NexaOS starts"); a logout always locks.
marker="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/nexa-logged-out"
if [ -f "$marker" ]; then
    rm -f "$marker"
    exec nexa-lock --boot
fi
# The opt-out is for the desktop that starts at boot only: a desktop
# started by "Switch person" was asked for by someone else, so it always
# opens locked, whatever its owner chose.
[ "${NEXA_SESSION_PRIMARY:-1}" = 1 ] && [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/nexa/skip-login-lock" ] && exit 0
exec nexa-lock --boot
