# NexaOS Buildroot Configuration
# Modern approach using Buildroot for Linux distribution building

CONFIG_BR2_ARCH_X86_64=y
CONFIG_BR2_OPTIMIZE_2=y
CONFIG_BR2_ENABLE_DEBUG=n
CONFIG_BR2_SYSTEM_ENABLE_NLS=y

# Kernel
CONFIG_LINUX_KERNEL_CUSTOM_VERSION=y
CONFIG_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.33"

# Toolchain
CONFIG_BR2_GCC_VERSION_13=y
CONFIG_BR2_BINUTILS_VERSION_2_41=y
CONFIG_BR2_GLIBC_VERSION_2_38=y
CONFIG_BR2_ENABLE_LTO=y

# Bootloader
CONFIG_BR2_TARGET_GRUB2=y
CONFIG_BR2_TARGET_GRUB2_EFI=y

# Filesystem
CONFIG_BR2_TARGET_ROOTFS_EXT2=y
CONFIG_BR2_TARGET_ROOTFS_ISO9660=y

# System
CONFIG_BR2_SYSTEM_HOSTNAME="nexa"
CONFIG_BR2_SYSTEM_DHCP="eth0"
CONFIG_BR2_INIT_SYSV=y

# Packages - Core utilities
CONFIG_BR2_PACKAGE_BUSYBOX=y
CONFIG_BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
CONFIG_BR2_PACKAGE_BASH=y
CONFIG_BR2_PACKAGE_DASH=y
CONFIG_BR2_PACKAGE_WGET=y
CONFIG_BR2_PACKAGE_CURL=y

# Packages - Networking
CONFIG_BR2_PACKAGE_OPENSSH=y
CONFIG_BR2_PACKAGE_DROPBEAR=y
CONFIG_BR2_PACKAGE_DHCP=y
CONFIG_BR2_PACKAGE_NET_TOOLS=y
CONFIG_BR2_PACKAGE_IPUTILS=y

# Packages - Development
CONFIG_BR2_PACKAGE_GCC=y
CONFIG_BR2_PACKAGE_MAKE=y
CONFIG_BR2_PACKAGE_PYTHON3=y
CONFIG_BR2_PACKAGE_TCC=y

# Packages - Libraries
CONFIG_BR2_PACKAGE_SDL2=y
CONFIG_BR2_PACKAGE_LVGL=y
CONFIG_BR2_PACKAGE_LIBPNG=y
CONFIG_BR2_PACKAGE_FREETYPE=y

# Packages - System utilities
CONFIG_BR2_PACKAGE_SYSTEMD=y
CONFIG_BR2_PACKAGE_SYSLOGD=y
CONFIG_BR2_PACKAGE_CRON=y

# Security
CONFIG_BR2_ROOTFS_MOUNTED_RO=y
CONFIG_BR2_ENABLE_SSP=y

# Build options
CONFIG_BR2_QUIET=n
CONFIG_BR2_VERBOSE=y
CONFIG_BR2_REPRODUCIBLE=y
