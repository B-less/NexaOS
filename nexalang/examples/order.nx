// NexaLang evaluates left to right, always.
fn note(s: str, v: int) -> int {
    print(s)
    return v
}

fn add3(a: int, b: int, c: int) -> int {
    return a + b + c
}

fn main() {
    let r = add3(note("first", 1), note("second", 2), note("third", 3))
    print("r = {r}")
    let s = note("left", 10) - note("right", 4)
    print("s = {s}")
    // `and` / `or` stop early
    if false and note("never", 1) == 1 {
        print("no")
    }
    if true or note("never", 1) == 1 {
        print("short-circuit ok")
    }
    let t = note("a", 1) * 10 + note("b", 2)
    print("t = {t}")
}
