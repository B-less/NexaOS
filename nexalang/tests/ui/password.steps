# program: tests/ui/password.nx
# broker
window Rename
key ctrl+r
window Enter your password
shot password-ask
type wrong one
key Return
window Enter your password
shot password-wrong
type open sesame
key Return
wait 0.3
# cancel
key ctrl+r
window Enter your password
key Escape
wait 0.3
# three wrong tries
key ctrl+r
window Enter your password
type a
key Return
window Enter your password
type b
key Return
window Enter your password
type c
key Return
wait 0.3
# the broker now refuses without asking
key ctrl+r
wait 0.3
shot password-locked
key Escape
