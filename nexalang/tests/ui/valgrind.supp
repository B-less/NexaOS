# librsvg (the SVG loader GTK uses for icons) is written in Rust; Valgrind
# reports its optimised Rust code as reading uninitialised memory, a known
# false alarm. Only reports whose innermost frame is in librsvg match.
{
   librsvg-rust-cond
   Memcheck:Cond
   obj:*/librsvg-2.so*
}
{
   librsvg-rust-value8
   Memcheck:Value8
   obj:*/librsvg-2.so*
}
# glibc's AVX2 wcpncpy reads whole 32-byte blocks past the end of a string
# (allowed, since it never crosses a page); Valgrind doesn't know that and
# reports it. GTK's file chooser (0.7) reaches it when it sorts file names
# (g_utf8_collate_key_for_filename -> wcsxfrm_l). Only that path matches.
{
   glibc-avx2-wcpncpy-overread
   Memcheck:Addr32
   fun:__wcpncpy_avx2
   fun:wcsxfrm_l
   fun:g_utf8_collate_key
}

# 0.8: GtkSourceView's highlighting runs regular expressions that GLib
# compiles to machine code at run time (PCRE2's JIT). Valgrind can't see
# that code's object or how it keeps its registers defined, and reports
# "conditional jump depends on uninitialised value" inside it. Matched
# only where every frame has no object at all (`???`: code made at run
# time), never in a library or the program.
{
   pcre2-jit-code
   Memcheck:Cond
   obj:???
}
