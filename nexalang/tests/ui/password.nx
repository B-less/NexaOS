// ui.broker_call against the stand-in broker (tests/broker/fake_broker.py):
// the password dialog, a wrong password, cancelling, three wrong tries,
// and the broker's lockout.
use ui
use json

fn main() -> !void {
    let page = ui.start("password-test", "Rename")?
    ui.label(page, "Rename this computer to studio.")
    let go = ui.primary_button(page, "Rename")
    ui.shortcut(go, "Ctrl+R")
    while true {
        match ui.wait() {
            Clicked(_) => {
                match ui.broker_call("set_hostname", json.obj([json.field("name", Json.Text("studio"))])) {
                    ok(result) => {
                        print("renamed: {json.to_text(result)}")
                        ui.status("Renamed.")
                    }
                    err(e) => {
                        print("not renamed: {e}")
                        ui.show_error("The computer wasn't renamed: {e}.")
                    }
                }
            }
            Closed => { return ok() }
            _ => { }
        }
    }
    return ok()
}
